# Másold át .env néven és töltsd ki!

# Cloud Function URL (step-06 terraform output)
# Példa: https://europe-west1-ford-training-430008.cloudfunctions.net/henry-ford-file-processor
FUNCTION_URL=https://europe-west1-ford-training-430008.cloudfunctions.net/henry-ford-file-processor

# Service Account key file name
# A demo SA kulcs fájl neve (amit feltöltöttél)
SA_KEY_FILE=../../../henry_ford.json

# Optional security token (sent in X-Goog-Channel-Token header)
# Bármilyen titkos string lehet, vagy hagyd üresen
WEBHOOK_TOKEN=